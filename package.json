{
  "name": "whm-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for WHM (WebHost Manager) API v1 — server-level cPanel administration: accounts, services, DNS, email, logs, packages, SSL",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "whm-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "whm", "cpanel", "anthropic", "claude"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
